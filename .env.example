# The demo sends to a local Lumberjack. These are the keys of the Demo project
# that Lumberjack's own seeder creates (php artisan migrate:fresh --seed there).
# For another project, copy its keys from the project's settings page and add
# https://laravel-lumberjack.test to its allowed origins.
LUMBERJACK_URL=https://lumberjack.test
LUMBERJACK_TOKEN=lj_srv_local_demo_project_server_token_0000000
LUMBERJACK_PUBLIC_KEY=pk_local_demo_project
LUMBERJACK_AGENT_PORT=2408

# The disk:rustfs health check writes to a bucket on lerd's RustFS service
# (lerd's default local credentials). Create the bucket once with
# php vendor/bin/testbench demo:bucket
RUSTFS_KEY=lerd
RUSTFS_SECRET=lerdpassword
RUSTFS_REGION=us-east-1
RUSTFS_BUCKET=lumberjack-workbench
RUSTFS_ENDPOINT=http://lerd-rustfs:9000

# The database:mysql health check reports connections and size from lerd's MySQL
# (lerd's default local credentials); the app itself runs on SQLite.
WORKBENCH_MYSQL_HOST=lerd-mysql
WORKBENCH_MYSQL_PORT=3306
WORKBENCH_MYSQL_DATABASE=mysql
WORKBENCH_MYSQL_USERNAME=root
WORKBENCH_MYSQL_PASSWORD=lerd
