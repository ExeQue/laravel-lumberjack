{
    "name": "exeque/lumberjack-laravel",
    "description": "Laravel SDK for Lumberjack: exceptions, requests, queries, jobs and logs, sent through a local agent.",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "Morten Harders",
            "email": "mmh@harders-it.dk"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-zlib": "*",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/queue": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/log": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0|^5.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.20"
    },
    "autoload": {
        "psr-4": {
            "ExeQue\\Lumberjack\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ExeQue\\Lumberjack\\LumberjackServiceProvider"
            ],
            "aliases": {
                "Lumberjack": "ExeQue\\Lumberjack\\Facades\\Lumberjack"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/pest -p",
        "lint": "vendor/bin/pint -p",
        "lint:test": "vendor/bin/pint -p --test",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "pre-commit": [
            "@composer lint",
            "@composer analyse",
            "@composer test"
        ],
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "agent": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/testbench lumberjack:agent --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/testbench serve --ansi --host=0.0.0.0 --port=8000"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
